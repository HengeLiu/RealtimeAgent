{
  "method": "post",
  "url": "/chat/completions",
  "headers": {
    "User-Agent": "Agents/Python 0.3.3"
  },
  "files": null,
  "idempotency_key": "sample-agent-request",
  "json_data": {
    "messages": [
      {
        "role": "system",
        "content": "你的名字是\"乐鑫\"。你是盲人眼镜上的中文语音助手，能帮助盲人用户识别图片、障碍物、引导过马路等，请用简短口语回答用户问题。\n请使用简短、口语化、直接的中文回答。\n必要时可以调用已提供的工具。\n不要输出代码块。\n"
      },
      {
        "role": "user",
        "content": "自我介绍。"
      },
      {
        "role": "assistant",
        "content": "你好，我是乐鑫，你的盲人眼镜语音助手。我可以帮你识别图片、障碍物，还能引导你安全过马路。"
      },
      {
        "role": "user",
        "content": "我眼前是什么？"
      }
    ],
    "model": "qwen3.6-plus",
    "response_format": {
      "type": "json_schema",
      "json_schema": {
        "name": "final_output",
        "strict": true,
        "schema": {
          "description": "Agent 最终结构化输出。",
          "properties": {
            "action": {
              "description": "当前轮最终动作",
              "enum": [
                "final_answer",
                "ask_user"
              ],
              "title": "Action",
              "type": "string"
            },
            "reply_text": {
              "description": "当前轮需要返回给用户的中文文本",
              "title": "Reply Text",
              "type": "string"
            }
          },
          "required": [
            "action",
            "reply_text"
          ],
          "title": "StructuredAgentReply",
          "type": "object",
          "additionalProperties": false
        }
      }
    },
    "stream": false,
    "tools": [
      {
        "type": "function",
        "function": {
          "name": "photo_interpret",
          "description": "当用户提问需要用到用户眼前图像时，先调用相机拍照，再根据图片回答用户问题。",
          "parameters": {
            "properties": {
              "question": {
                "title": "Question",
                "type": "string"
              },
              "capture_first": {
                "default": true,
                "title": "Capture First",
                "type": "boolean"
              },
              "photo_asset_id": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Photo Asset Id"
              }
            },
            "required": [
              "question"
            ],
            "title": "photo_interpret_args",
            "type": "object"
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "timer_manage",
          "description": "当用户要创建、查询或取消计时器时使用。",
          "parameters": {
            "properties": {
              "action": {
                "default": "auto",
                "enum": [
                  "auto",
                  "create",
                  "query",
                  "cancel"
                ],
                "title": "Action",
                "type": "string"
              },
              "duration_seconds": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Duration Seconds"
              },
              "task_id": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Task Id"
              },
              "label": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Label"
              },
              "query": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Query"
              }
            },
            "title": "timer_manage_args",
            "type": "object"
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "map_manage",
          "description": "当用户需要搜索地点、确认地址位置或规划路线时使用。如果用户已经给出起点和终点，就规划路线；如果只是找地点，就先搜索地点。",
          "parameters": {
            "properties": {
              "action": {
                "default": "auto",
                "enum": [
                  "auto",
                  "search",
                  "geocode",
                  "route"
                ],
                "title": "Action",
                "type": "string"
              },
              "query": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Query"
              },
              "city": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "City"
              },
              "address": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Address"
              },
              "origin": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Origin"
              },
              "destination": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Destination"
              },
              "strategy": {
                "default": "walking",
                "title": "Strategy",
                "type": "string"
              }
            },
            "title": "map_manage_args",
            "type": "object"
          }
        }
      }
    ]
  }
}
