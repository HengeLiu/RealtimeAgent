{
  "name": "OpenAIGlassesPhoneSDK",
  "version": "sdk-v14",
  "package_type": "xcode-source-runtime",
  "minimum_ios": "17.0",
  "minimum_swift": "5.9",
  "xcode_project": "GlassesVideoReceiver.xcodeproj",
  "runtime_files": [
    "GlassesVideoReceiver/GlassesVideoReceiverApp.swift",
    "GlassesVideoReceiver/ContentView.swift",
    "GlassesVideoReceiver/Core/CameraStreamStore.swift",
    "GlassesVideoReceiver/Core/IPAddressProvider.swift",
    "GlassesVideoReceiver/Core/MediaFrameDecoder.swift",
    "GlassesVideoReceiver/Core/VisionResourceCoordinator.swift",
    "GlassesVideoReceiver/Networking/CameraSinkConnection.swift",
    "GlassesVideoReceiver/Networking/CameraSinkServer.swift",
    "GlassesVideoReceiver/Networking/PhoneTaskEventReportAPI.swift",
    "GlassesVideoReceiver/Networking/WebSocketFrameParser.swift",
    "GlassesVideoReceiver/Networking/WebSocketHandshake.swift"
  ],
  "test_files": [
    "GlassesVideoReceiverTests/GlassesVideoReceiverTests.swift"
  ],
  "resource_files": [
    "GlassesVideoReceiver/AppConfig.plist",
    "GlassesVideoReceiver/Info.plist"
  ],
  "public_capabilities": [
    "device.register",
    "heartbeat",
    "camera_sink",
    "phone_task_start_stop",
    "phone_task_event_report",
    "multi_capability_registry"
  ],
  "distribution_notes": [
    "sdk-v14 提供源码包清单和 package-check 校验，业务工程可以按清单引用通用运行时代码。",
    "当前不是二进制 XCFramework，也不是 package-first Swift Package；二进制发布需要后续拆 framework target 和 public API。"
  ]
}
