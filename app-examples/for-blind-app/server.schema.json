{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audio-chat.local/schemas/server.schema.json",
  "title": "audio-chat server.yaml",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "app-name": {
      "type": "string",
      "description": "应用名称。SDK 支持 app_name；推荐使用 app-name。"
    },
    "app_name": {
      "type": "string",
      "description": "应用名称备用字段。"
    },
    "server": {
      "$ref": "#/$defs/server"
    },
    "auth": {
      "$ref": "#/$defs/auth"
    },
    "user": {
      "$ref": "#/$defs/user"
    },
    "control": {
      "$ref": "#/$defs/control"
    },
    "stream": {
      "$ref": "#/$defs/stream"
    },
    "audio_pipeline": {
      "$ref": "#/$defs/audioPipeline"
    },
    "asset": {
      "$ref": "#/$defs/asset"
    },
    "agent": {
      "$ref": "#/$defs/agent"
    },
    "output": {
      "$ref": "#/$defs/output"
    },
    "tools": {
      "$ref": "#/$defs/tools"
    },
    "tasks": {
      "$ref": "#/$defs/tasks"
    },
    "memory": {
      "$ref": "#/$defs/memory"
    },
    "skill": {
      "$ref": "#/$defs/skill"
    },
    "mcp": {
      "$ref": "#/$defs/mcp"
    },
    "endpoint_defaults": {
      "$ref": "#/$defs/endpointDefaults"
    },
    "observability": {
      "$ref": "#/$defs/observability"
    },
    "dev_checks": {
      "$ref": "#/$defs/devChecks"
    }
  },
  "$defs": {
    "server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string",
          "default": "0.0.0.0"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 8765
        },
        "public_url": {
          "type": "string",
          "description": "端侧连接 server 使用的 HTTP URL。"
        },
        "log_level": {
          "type": "string",
          "enum": ["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"],
          "default": "DEBUG"
        },
        "debug_api_enabled": {
          "type": "boolean",
          "default": true
        },
        "shutdown_grace_seconds": {
          "type": "integer",
          "minimum": 0,
          "default": 10
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["disabled", "static_token", "signed_token"],
          "default": "disabled"
        },
        "device_tokens": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "signed_token_secret_env": {
          "type": "string"
        },
        "token_clock_skew_seconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "user": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "active_device_set_policy": {
          "type": "string",
          "enum": ["single"]
        },
        "message_store": {
          "type": "object",
          "additionalProperties": true
        },
        "recent_message_limit": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "transport": {
          "type": "string",
          "enum": ["websocket"]
        },
        "heartbeat_timeout_seconds": {
          "type": "number",
          "minimum": 0
        },
        "heartbeat_check_interval_seconds": {
          "type": "number",
          "minimum": 0
        },
        "max_routes_per_device": {
          "type": "integer",
          "minimum": 1
        },
        "allow_route_all": {
          "type": "boolean"
        },
        "route_filter_mode": {
          "type": "string",
          "enum": ["exact"]
        },
        "exclude_producer_by_default": {
          "type": "boolean"
        }
      }
    },
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "transport": {
          "type": "string",
          "enum": ["websocket_binary"]
        },
        "max_chunk_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "idle_timeout_seconds": {
          "type": "number",
          "minimum": 0
        },
        "default_sensor_mic": {
          "$ref": "#/$defs/streamFormat"
        },
        "default_actuator_speaker": {
          "$ref": "#/$defs/streamFormat"
        },
        "sensors": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "rgb_ttl_seconds": {
              "type": "number",
              "minimum": 0
            },
            "depth_ttl_seconds": {
              "type": "number",
              "minimum": 0
            },
            "imu_ttl_seconds": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "streamFormat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "codec": {
          "type": "string",
          "enum": ["pcm16le", "jpeg", "png", "raw"]
        },
        "sample_rate": {
          "type": "integer",
          "minimum": 1
        },
        "channels": {
          "type": "integer",
          "minimum": 1
        },
        "chunk_ms": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "audioPipeline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "aec": {
          "type": "string",
          "enum": ["endpoint_only"]
        },
        "resample": {
          "type": "string",
          "enum": ["auto", "disabled", "off", "false"]
        },
        "volume_normalize": {
          "type": "boolean"
        },
        "vad": {
          "type": "string",
          "enum": ["endpoint_only", "server_only", "endpoint_or_server", "provider", "disabled"]
        },
        "asr_sidecar": {
          "type": "string",
          "enum": ["required", "optional", "disabled"]
        },
        "silence_close_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "max_session_seconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "store_type": {
          "type": "string",
          "enum": ["filesystem", "memory"]
        },
        "root": {
          "type": "string"
        },
        "max_asset_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "default_ttl_seconds": {
          "type": "number",
          "minimum": 0
        },
        "request_timeout_seconds": {
          "type": "number",
          "minimum": 0
        },
        "selection_policy": {
          "type": "string",
          "enum": ["latest", "first", "highest_quality"]
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["text", "realtime_audio", "auto", "custom"],
          "description": "启动 Text 大模型路线时使用 text。"
        },
        "custom_core": {
          "type": "string"
        },
        "realtime": {
          "$ref": "#/$defs/agentRealtime"
        },
        "text": {
          "$ref": "#/$defs/agentText"
        }
      }
    },
    "agentRealtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["qwen", "mock"]
        },
        "model": {
          "type": "string"
        },
        "turn_detection": {
          "type": "string",
          "enum": ["provider", "server", "endpoint"]
        },
        "voice": {
          "type": "string"
        },
        "instructions": {
          "type": "string"
        },
        "session_idle_timeout_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "custom_adapter": {
          "type": "string"
        }
      }
    },
    "agentText": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model_provider": {
          "type": "string",
          "enum": ["mock", "openai-compatible", "dashscope-compatible"],
          "description": "当前代码真实支持 mock/openai-compatible/dashscope-compatible。"
        },
        "model": {
          "type": "string"
        },
        "system_prompt": {
          "type": "string"
        },
        "asr_provider": {
          "type": "string",
          "enum": ["mock", "dashscope"],
          "description": "当前代码真实支持 mock/dashscope。"
        },
        "asr_model": {
          "type": "string"
        },
        "tts_provider": {
          "type": "string",
          "enum": ["mock", "dashscope"],
          "description": "当前代码真实支持 mock/dashscope。"
        },
        "tts_model": {
          "type": "string"
        },
        "tts_voice": {
          "type": "string"
        },
        "streaming_tts": {
          "type": "boolean"
        },
        "max_context_messages": {
          "type": "integer",
          "minimum": 1
        },
        "allow_mock_fallback": {
          "type": "boolean"
        },
        "request_timeout_seconds": {
          "type": "number",
          "minimum": 0
        },
        "max_retries": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default_priority": {
          "type": "string",
          "enum": ["low", "normal", "high", "critical"]
        },
        "default_ttl_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "allow_same_priority_interrupt": {
          "type": "boolean"
        },
        "default_on_interrupted": {
          "type": "string",
          "enum": ["drop", "requeue"]
        },
        "default_on_blocked": {
          "type": "string",
          "enum": ["queue", "drop"]
        },
        "max_queue_size": {
          "type": "integer",
          "minimum": 0
        },
        "tool_progress_audio_mode": {
          "type": "string",
          "enum": ["cached", "realtime", "disabled"]
        },
        "tool_progress_priority": {
          "type": "string",
          "enum": ["low", "normal", "high", "critical"]
        },
        "tool_progress_ttl_seconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "packages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recursive": {
          "type": "boolean"
        },
        "fail_fast": {
          "type": "boolean"
        }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "builtin_enabled": {
          "type": "boolean"
        },
        "discover": {
          "$ref": "#/$defs/discovery"
        },
        "allowlist": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "denylist": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "default_timeout_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "allow_parallel_calls": {
          "type": "boolean"
        }
      }
    },
    "tasks": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "discover": {
          "$ref": "#/$defs/discovery"
        },
        "max_running_per_user": {
          "type": "integer",
          "minimum": 0
        },
        "store": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "type": {
              "type": "string",
              "enum": ["memory", "jsonl"]
            },
            "root": {
              "type": "string"
            }
          }
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "store_type": {
          "type": "string",
          "enum": ["jsonl"]
        },
        "path": {
          "type": "string"
        }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "roots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allow_tool_policy": {
          "type": "boolean"
        }
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "config_path": {
          "type": "string"
        },
        "default_timeout_seconds": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "endpointDefaults": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "wake_word": {
          "type": "string"
        },
        "aec": {
          "type": "string"
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event"],
      "properties": {
        "event": {
          "type": "string"
        },
        "filter": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runs_root": {
          "type": "string"
        },
        "record_input_streams": {
          "type": "boolean"
        },
        "record_output_streams": {
          "type": "boolean"
        },
        "record_model_events": {
          "type": "boolean"
        },
        "record_control_events": {
          "type": "boolean"
        },
        "record_stream_events": {
          "type": "boolean"
        },
        "max_debug_sessions": {
          "type": "integer",
          "minimum": 0
        },
        "retention_days": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "devChecks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run_contract_tests": {
          "type": "boolean"
        },
        "run_package_check": {
          "type": "boolean"
        },
        "run_boundary_check": {
          "type": "boolean"
        },
        "contract_tests_path": {
          "type": "string"
        },
        "report_path": {
          "type": "string"
        },
        "require_recent_playback_ok": {
          "type": "boolean"
        },
        "require_recent_playback": {
          "type": "boolean",
          "deprecated": true
        }
      }
    }
  }
}
