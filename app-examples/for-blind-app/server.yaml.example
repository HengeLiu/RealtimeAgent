# yaml-language-server: $schema=./server.schema.json
#
# audio-chat for-blind-app server 配置示例。
#
# 使用方式：
# 1. 复制本文件为 app-examples/for-blind-app/server.yaml。
# 2. 如果要启动真实 Text 大模型路线，保留 agent.mode: "text"，并设置环境变量：
#      export DASHSCOPE_API_KEY="你的百炼 API Key"
# 3. 启动 server：
#      uv run audio-chat.server.run --config app-examples/for-blind-app/server.yaml
#
# Text 路线真实链路：
# sensor.mic stream -> Audio Pipeline -> DashScope ASR -> TextAgentCore
# -> dashscope-compatible 文本模型 -> ToolGateway -> Streaming TTS -> actuator.speaker stream

app-name: "for-blind-app"

server:
  # 本地开发可以保持 0.0.0.0，让同一局域网设备连接。
  host: "0.0.0.0"
  port: 8765
  # 端侧看到的 server 地址。真机联调时改成 Mac 或服务器的局域网 IP。
  public_url: "http://127.0.0.1:8765"
  # 本地开发推荐 DEBUG；部署时可改 INFO。
  log_level: "DEBUG"
  debug_api_enabled: true
  shutdown_grace_seconds: 10

auth:
  # disabled 适合本地联调；真机或多人环境建议 static_token 或 signed_token。
  # 可选 disabled / static_token / signed_token。
  mode: "disabled"
  device_tokens: {}
  signed_token_secret_env: "AUDIO_CHAT_DEVICE_TOKEN_SECRET"
  token_clock_skew_seconds: 60

user:
  # 当前实现只支持 single，即每个 user_id 只有一个正在运行的设备组。
  active_device_set_policy: "single"
  message_store:
    type: "jsonl"
    root: "runs/audio-chat/for-blind-app/users"
  recent_message_limit: 200

control:
  transport: "websocket"
  heartbeat_timeout_seconds: 30
  heartbeat_check_interval_seconds: 5
  max_subscriptions_per_device: 64
  allow_subscribe_all: false
  subscription_filter_mode: "exact"
  exclude_producer_by_default: true

stream:
  transport: "websocket_binary"
  max_chunk_bytes: 1048576
  idle_timeout_seconds: 20
  # Text 路线要求端侧麦克风上传 pcm16le；如果采样率不一致，audio_pipeline.resample=auto 会尝试转换。
  default_sensor_mic:
    codec: "pcm16le"
    sample_rate: 16000
    channels: 1
    chunk_ms: 20
  # Text 路线下，模型输出文本会进入 TTS，再以下面的格式下发给端侧播放器。
  # DashScope TTS 支持的采样率会由 SDK 适配到这里声明的 sample_rate。
  default_actuator_speaker:
    codec: "pcm16le"
    sample_rate: 24000
    channels: 1
    chunk_ms: 20
  sensors:
    rgb_ttl_seconds: 30
    depth_ttl_seconds: 10
    imu_ttl_seconds: 10

audio_pipeline:
  # AEC 仍应在端侧完成，server 不承担真正回声消除。
  aec: "endpoint_only"
  # auto 会把端侧 pcm16le 归一到 default_sensor_mic 声明的格式。
  # 可选 auto / disabled / off / false。
  resample: "auto"
  volume_normalize: true
  # Text 主链路的 turn boundary 由端侧 final chunk 或 ASR provider 决定；这里主要用于质量诊断。
  # 可选 endpoint_only / server_only / endpoint_or_server / provider / disabled。
  vad: "endpoint_or_server"
  # sidecar 只用于调试转写或质量诊断，不是 TextAgentCore 主 ASR。
  # 可选 required / optional / disabled。
  asr_sidecar: "optional"
  silence_close_seconds: 15
  # 0 表示不按时长强制关闭会话。
  max_session_seconds: 0

asset:
  store_type: "filesystem"
  root: "runs/audio-chat/for-blind-app/assets"
  max_asset_bytes: 10485760
  default_ttl_seconds: 60
  request_timeout_seconds: 5
  selection_policy: "latest"

agent:
  # 启动 Text 大模型路线必须使用 text。
  # realtime_audio 是 Omni / realtime audio 路线；auto 当前代码会保守落到 text。
  # 可选 text / realtime_audio / auto / custom。
  mode: "text"
  custom_core: ""

  # mode=text 时不会使用 realtime 配置；保留该块只是为了切回 Omni 路线时少改文件。
  realtime:
    provider: "qwen"
    model: "qwen3.5-omni-plus-realtime"
    turn_detection: "provider"
    voice: "Tina"
    instructions: "你的名字是'乐鑫'。你是盲人眼镜上的中文语音助手，能帮助盲人用户识别图片、障碍物、引导过马路等。请使用简短、口语化、直接的中文回答。必要时可以调用已提供的工具。不要输出代码块。"
    session_idle_timeout_seconds: 60
    custom_adapter: ""

  text:
    # 文本模型 provider。当前代码真实支持 mock / openai-compatible / dashscope-compatible。
    # 使用百炼兼容 OpenAI Chat Completions 接口时选择 dashscope-compatible。
    model_provider: "dashscope-compatible"
    # 文本模型名，例如 qwen-plus、qwen-max、qwen-turbo 等，按百炼账号可用模型填写。
    model: "qwen-plus"
    # TextAgentCore 的系统提示词，会和 memory 指令合并后写入 model-request.json。
    system_prompt: "你的名字是'乐鑫'。你是盲人眼镜上的中文语音助手，能帮助盲人用户识别图片、障碍物、引导过马路等。请使用简短、口语化、直接的中文回答。必要时可以调用已提供的工具。不要输出代码块。"

    # ASR provider。当前代码真实支持 mock / dashscope。
    # dashscope 需要 DASHSCOPE_API_KEY，输入要求 pcm16le / 16k / mono。
    asr_provider: "dashscope"
    asr_model: "paraformer-realtime-v2"

    # TTS provider。当前代码真实支持 mock / dashscope。
    # dashscope 需要 DASHSCOPE_API_KEY；输出音色和模型必须是百炼账号可用值。
    tts_provider: "dashscope"
    tts_model: "cosyvoice-v3-flash"
    tts_voice: "longanhuan"
    streaming_tts: true

    # 目前 TextAgentCore 会记录 model-request.json；上下文裁剪能力后续会继续完善。
    max_context_messages: 30
    # true：缺少 key 或依赖时降级到 mock，适合本地联调；
    # false：缺少真实 provider 时启动或调用直接失败，适合确认真实大模型链路。
    allow_mock_fallback: false
    request_timeout_seconds: 10
    max_retries: 1

output:
  default_priority: "normal"
  default_ttl_seconds: 10
  allow_same_priority_interrupt: false
  default_on_interrupted: "drop"
  default_on_blocked: "queue"
  max_queue_size: 32
  tool_progress_audio_mode: "cached"
  tool_progress_priority: "low"
  tool_progress_ttl_seconds: 10

tools:
  enabled: true
  builtin_enabled: true
  discover:
    enabled: true
    packages:
      - "capabilities"
    recursive: true
    fail_fast: true
  allowlist: []
  denylist: []
  default_timeout_seconds: 30
  allow_parallel_calls: true

tasks:
  enabled: true
  discover:
    enabled: true
    packages:
      - "capabilities"
    recursive: true
    fail_fast: true
  max_running_per_user: 16
  store:
    type: "memory"
    root: "runs/audio-chat/for-blind-app/tasks"

memory:
  enabled: true
  store_type: "jsonl"
  path: "runs/audio-chat/for-blind-app/memory"

skill:
  enabled: false
  roots: []
  allow_tool_policy: true

mcp:
  enabled: false
  config_path: "app-examples/for-blind-app/config/mcp.yaml"
  default_timeout_seconds: 30

endpoint_defaults:
  wake_word: "endpoint"
  aec: "endpoint"
  subscriptions:
    - event: "control.audio_session.*"
    - event: "stream.output.*"
      filter:
        stream_type: "actuator.speaker"
    - event: "stream.control.*"
      filter:
        stream_type: "sensor.rgb"

observability:
  runs_root: "runs/audio-chat/for-blind-app"
  record_input_streams: true
  record_output_streams: true
  record_model_events: true
  record_control_events: true
  record_stream_events: true
  max_debug_sessions: 100
  retention_days: 7

dev_checks:
  run_contract_tests: true
  run_package_check: true
  run_boundary_check: true
  contract_tests_path: "testdata/contracts"
  require_recent_playback_ok: false
  report_path: "runs/audio-chat/for-blind-app/preflight.json"
