{
  "server_url": "http://192.168.10.3:8765",
  "user_id": "user-playback-001",
  "device_id": "dev-ios-phone-001",
  "auth": {
    "mode": "disabled"
  },
  "protocol_version": "audio-chat.v1",
  "properties": {
    "audio.aec": "replaceable",
    "audio.wake_word": "manual"
  },
  "supports": {
    "sensors": [
      {
        "type": "rgb",
        "modes": [
          "single",
          "continuous"
        ],
        "default": {
          "format": "jpeg",
          "frequency_hz": 1,
          "sample_count": 1
        }
      }
    ],
    "actuators": [
      {
        "type": "vibrator",
        "commands": [
          "vibrate"
        ]
      }
    ]
  }
}
