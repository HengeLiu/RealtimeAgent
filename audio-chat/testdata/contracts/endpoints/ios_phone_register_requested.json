        "sensor.mic"
      ]
    },
    "client_type": "ios-phone",
    "device_id": "dev-ios-phone-001",
    "device_name": "ios-phone-reference",
    "sdk_version": "audio-chat-ios-reference-0.1.0",
    "subscriptions": [
      {
        "event": "stream.control.*",
        "filter": {
          "stream_type": "sensor.rgb"
        }
      },
      {
        "event": "stream.output.*",
        "filter": {
          "stream_type": "actuator.speaker"
        }
      },
      {
        "event": "control.audio_session.*"
      }
    ]
  },
  "producer_id": "dev-ios-phone-001",
