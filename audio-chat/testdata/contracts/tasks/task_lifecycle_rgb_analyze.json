{
  "name": "task_lifecycle_rgb_analyze",
  "status": "implemented_contract",
  "task_type": "continuous_rgb_analyze",
  "allowed_states": [
    "scheduled",
    "running",
    "waiting_external",
    "completed",
    "cancelled",
    "failed",
    "timeout"
  ],
  "expected_events": [
    {
      "event_name": "task.state.changed",
      "payload": {
        "from": "scheduled",
        "to": "running",
        "task_type": "continuous_rgb_analyze"
      }
    },
    {
      "event_name": "stream.control.configure.requested",
      "stream_type": "sensor.rgb",
      "payload": {
        "mode": "continuous",
        "asset_policy": "cache",
        "correlation_id": "task-rgb-001"
      }
    },
    {
      "event_name": "task.state.changed",
      "payload": {
        "from": "running",
        "to": "completed",
        "task_type": "continuous_rgb_analyze"
      }
    }
  ],
  "constraints": {
    "device_access": "UserDeviceContext only",
    "media_bytes": "stream only",
    "cancel_event": {
      "event_name": "stream.control.configure.requested",
      "stream_type": "sensor.rgb",
      "payload": {"mode": "stop"}
    }
  }
}
