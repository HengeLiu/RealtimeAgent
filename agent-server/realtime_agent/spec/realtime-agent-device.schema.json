{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:realtime-agent:device.schema.json",
  "title": "realtime-agent device capability file",
  "type": "object",
  "additionalProperties": false,
  "required": ["device_id", "user_id", "supports"],
  "anyOf": [
    {"required": ["name"]},
    {"required": ["device_name"]}
  ],
  "properties": {
    "$schema": {"type": "string"},
    "device_id": {"type": "string", "minLength": 1},
    "user_id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "device_name": {"type": "string", "minLength": 1},
    "device_role": {"type": "string", "minLength": 1},
    "tags": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "client_type": {"type": "string"},
    "sdk_version": {"type": "string"},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "platform": {"type": "string", "enum": ["browser", "ios", "android", "esp32", "python", "linux", "macos", "unknown"]},
        "language": {"type": "string", "enum": ["javascript", "typescript", "swift", "c", "cpp", "python", "kotlin", "unknown"]},
        "version": {"type": "string"}
      }
    },
    "properties": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "integer", "boolean", "array", "object", "null"]
      }
    },
    "supports": {"$ref": "#/$defs/structuredSupports"}
  },
  "$defs": {
    "looseObject": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "integer", "boolean", "array", "object", "null"]
      }
    },
    "structuredSupports": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "sensors": {
          "type": "array",
          "items": {"$ref": "#/$defs/structuredSensorSupport"}
        },
        "actuators": {
          "type": "array",
          "items": {"$ref": "#/$defs/structuredActuatorSupport"}
        }
      }
    },
    "structuredSensorSupport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"type": "string", "enum": ["rgb", "imu", "tof"]},
        "modes": {
          "type": "array",
          "items": {"type": "string", "enum": ["single", "continuous"]},
          "minItems": 1,
          "uniqueItems": true
        },
        "default": {"$ref": "#/$defs/capabilityDefaults"},
        "external": {"$ref": "#/$defs/looseObject"}
      }
    },
    "structuredActuatorSupport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"type": "string", "enum": ["vibrator", "haptic"]},
        "commands": {
          "type": "array",
          "items": {"type": "string", "enum": ["vibrate"]},
          "minItems": 1,
          "uniqueItems": true
        },
        "default": {"$ref": "#/$defs/capabilityDefaults"},
        "external": {"$ref": "#/$defs/looseObject"}
      }
    },
    "capabilityDefaults": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "integer", "boolean", "array", "object", "null"]
      },
      "properties": {
        "modes": {
          "type": "array",
          "items": {"type": "string", "enum": ["single", "continuous"]},
          "minItems": 1,
          "uniqueItems": true
        },
        "fps": {"type": "number", "exclusiveMinimum": 0},
        "frequency_hz": {"type": "number", "exclusiveMinimum": 0},
        "sample_count": {"type": "integer", "minimum": 0},
        "duration_seconds": {"type": "number", "minimum": 0},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "format": {"type": "string", "enum": ["jpeg", "png"]},
        "formats": {
          "type": "array",
          "items": {"type": "string", "enum": ["jpeg", "png"]},
          "minItems": 1,
          "uniqueItems": true
        },
        "commands": {
          "type": "array",
          "items": {"type": "string", "enum": ["vibrate"]},
          "minItems": 1,
          "uniqueItems": true
        },
        "options": {"$ref": "#/$defs/looseObject"}
      }
    }
  }
}
