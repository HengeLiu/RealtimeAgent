{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:realtime-agent:stream.schema.json",
  "title": "realtime-agent stream chunk header",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "user_id",
    "session_id",
    "stream_id",
    "stream_type",
    "seq",
    "timestamp_ms",
    "codec",
    "payload_size",
    "final"
  ],
  "properties": {
    "version": {"type": "string", "const": "realtime-agent.v1"},
    "user_id": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "stream_id": {"type": "string", "minLength": 1},
    "stream_type": {
      "type": "string",
      "enum": ["sensor.mic", "sensor.rgb", "sensor.imu", "sensor.tof", "sensor.depth", "actuator.speaker", "actuator.haptic", "actuator.vibrator"]
    },
    "seq": {"type": "integer", "minimum": 0},
    "timestamp_ms": {"type": "integer", "minimum": 0},
    "codec": {"type": "string", "minLength": 1},
    "sample_rate": {"type": "integer", "minimum": 0},
    "channels": {"type": "integer", "minimum": 0},
    "duration_ms": {"type": "integer", "minimum": 0},
    "payload_size": {"type": "integer", "minimum": 0},
    "final": {"type": "boolean"},
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "integer", "boolean", "array", "object", "null"]
      }
    }
  }
}
