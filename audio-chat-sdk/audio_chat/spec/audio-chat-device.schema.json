{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai-glasses.github.io/audio-chat/spec/audio-chat-device.schema.json",
  "title": "audio-chat device capability file",
  "type": "object",
  "additionalProperties": false,
  "required": ["device_id", "user_id", "name", "supports"],
  "properties": {
    "$schema": {"type": "string"},
    "device_id": {"type": "string", "minLength": 1},
    "user_id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "device_name": {"type": "string"},
    "client_type": {"type": "string"},
    "sdk_version": {"type": "string"},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "platform": {"type": "string", "enum": ["browser", "ios", "android", "esp32", "python", "linux", "macos", "unknown"]},
        "language": {"type": "string", "enum": ["javascript", "typescript", "swift", "c", "cpp", "python", "kotlin", "unknown"]},
        "version": {"type": "string"}
      }
    },
    "properties": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "integer", "boolean", "array", "object", "null"]
      }
    },
    "supports": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/support"}
    }
  },
  "$defs": {
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "sensor.rgb",
            "sensor.imu",
            "sensor.mic",
            "sensor.tof",
            "actuator.speaker",
            "actuator.haptic"
          ]
        },
        "modes": {
          "type": "array",
          "items": {"type": "string", "enum": ["single", "continuous"]},
          "minItems": 1,
          "uniqueItems": true
        },
        "formats": {
          "type": "array",
          "items": {"type": "string", "enum": ["jpeg", "png"]},
          "minItems": 1,
          "uniqueItems": true
        },
        "codecs": {
          "type": "array",
          "items": {"type": "string", "enum": ["pcm16le", "opus"]},
          "minItems": 1,
          "uniqueItems": true
        },
        "commands": {
          "type": "array",
          "items": {"type": "string", "enum": ["vibrate"]},
          "minItems": 1,
          "uniqueItems": true
        },
        "sample_rate_hz": {"type": "integer", "minimum": 1},
        "sample_rates_hz": {
          "type": "array",
          "items": {"type": "integer", "minimum": 1},
          "minItems": 1,
          "uniqueItems": true
        },
        "channels": {"type": "integer", "minimum": 1},
        "frequency_hz": {"type": "number", "exclusiveMinimum": 0},
        "sample_count": {"type": "integer", "minimum": 0},
        "duration_seconds": {"type": "number", "minimum": 0},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "options": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "integer", "boolean", "array", "object", "null"]
          }
        }
      }
    }
  }
}
