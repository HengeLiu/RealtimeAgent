# 本地服务端启动配置示例。
# 使用方式：
# 1. 复制为 config/local_server.env
# 2. 按当前局域网环境修改
# 3. 直接执行 bash script/run_server.sh local start

HOST="0.0.0.0"
PORT="8765"
LOG_LEVEL="DEBUG"
DEVICE_TOKEN_MAP="glass-001=pair-demo-token,phone-001=pair-phone-token"
HEARTBEAT_INTERVAL_MS="5000"
HEARTBEAT_TIMEOUT_MS="15000"
SERVER_DEVICE_ID="server-main"

# 仅用于脚本打印提示，帮助联调时确认局域网访问地址。
SERVER_PUBLIC_HOST="172.20.10.12"
