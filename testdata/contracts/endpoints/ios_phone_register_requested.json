{
  "event_id": "evt-contract-ios-phone-register-requested",
  "event_name": "control.device.register.requested",
  "payload": {
    "auth": {
      "mode": "disabled"
    },
    "properties": {
      "audio.aec": "replaceable",
      "audio.wake_word": "manual",
      "direct.camera_sink": true,
      "direct.camera_sink.frame_format": "audio_chat.direct_frame.v1",
      "direct.camera_sink.path": "/ws/camera",
      "direct.camera_sink.port": 9001,
      "phone.task.find_object_phone_task": true,
      "phone.task.traffic_light_phone_task": true
    },
    "client_type": "ios-phone",
    "device_id": "dev-ios-phone-001",
    "name": "iOS 设备示例",
    "device_name": "ios-phone-reference",
    "sdk_version": "audio-chat-ios-reference-0.1.0",
    "supports": [
      {
        "id": "sensor.rgb",
        "modes": ["single", "continuous"],
        "formats": ["jpeg"],
        "frequency_hz": 1,
        "sample_count": 1
      },
      {
        "id": "sensor.mic",
        "modes": ["continuous"],
        "sample_rate_hz": 16000,
        "channels": 1,
        "frequency_hz": 50,
        "duration_seconds": 0,
