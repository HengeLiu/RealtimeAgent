{
  "scenario_id": "find_object_with_heading_sensor",
  "title": "寻找物体结合方向角传感器样例",
  "description": "验证找物体手机任务可以在处理视频帧时读取 heading 传感器并把方向角写入结构化结果。",
  "capability": "find_object",
  "device_group": {
    "glass": "mock_glass_001",
    "phone": "mock_phone_001"
  },
  "inputs": {
    "target_object": "水杯",
    "frames": "text/find_object_frames_water_cup.json",
    "processor_type": "yolo_find_object",
    "phone_task_params": {
      "heading_sensor_type": "heading"
    },
    "sensors": {
      "heading": "sensor/find_object_heading.json"
    }
  },
  "expected": {
    "task_state": "completed",
    "task_result": {
      "found": true,
      "target_object": "水杯",
      "heading_degrees": 92
    },
    "notification_contains": "找到水杯",
    "notification_count_at_least": 1,
    "glass_commands": [
      "sensor.camera.stream.start"
    ]
  }
}
