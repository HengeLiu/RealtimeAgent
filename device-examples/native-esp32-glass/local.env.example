AUDIO_CHAT_SERVER_URL=http://127.0.0.1:8765
AUDIO_CHAT_CONTROL_WS_URL=ws://127.0.0.1:8765/ws/control
AUDIO_CHAT_STREAM_WS_URL=ws://127.0.0.1:8765/ws/stream
AUDIO_CHAT_USER_ID=user-endpoint-001
AUDIO_CHAT_DEVICE_ID=dev-esp32-s3-001
AUDIO_CHAT_AUTH_MODE=disabled
AUDIO_CHAT_AUTH_TOKEN=
AUDIO_CHAT_WAKE_WORD_MODE=endpoint
AUDIO_CHAT_AEC_MODE=endpoint
AUDIO_CHAT_PLAYBACK_REFERENCE=endpoint_ring_buffer
AUDIO_CHAT_PHONE_CAMERA_SINK_WS_URI=
AUDIO_CHAT_PHONE_CAMERA_STREAM_INTERVAL_MS=500
AUDIO_CHAT_AUDIO_CODEC=pcm16le
AUDIO_CHAT_AUDIO_SAMPLE_RATE=16000
AUDIO_CHAT_AUDIO_CHANNELS=1
AUDIO_CHAT_AUDIO_CHUNK_MS=20
AUDIO_CHAT_STREAMS_PRODUCE=["sensor.mic","sensor.rgb"]
AUDIO_CHAT_STREAMS_CONSUME=["actuator.speaker"]
AUDIO_CHAT_SUBSCRIPTIONS=[{"event":"control.audio_session.*"},{"event":"stream.output.*","filter":{"stream_type":"actuator.speaker"}},{"event":"stream.output.cancel.*","filter":{"stream_type":"actuator.speaker"}},{"event":"stream.control.*","filter":{"stream_type":"sensor.rgb"}}]
