{
  "$schema": "../../../agent-server/realtime_agent/spec/realtime-agent-device.schema.json",
  "device_id": "dev-esp32-glass-001",
  "user_id": "user-browser-glass-001",
  "name": "ESP32-S3 Glass",
  "device_role": "glass",
  "client_type": "esp32",
  "sdk_version": "esp32-reference",
  "runtime": {
    "platform": "esp32",
    "language": "c"
  },
  "properties": {
    "realtime_agent.audio_input": "sensor.mic",
    "realtime_agent.audio_output": "actuator.speaker"
  },
  "supports": {
    "sensors": [
      {
        "type": "rgb",
        "modes": ["single"],
        "default": {
          "format": "jpeg",
          "frequency_hz": 1,
          "sample_count": 1
        }
      }
    ],
    "actuators": [
      {
        "type": "vibrator",
        "commands": ["vibrate"]
      }
    ]
  }
}
