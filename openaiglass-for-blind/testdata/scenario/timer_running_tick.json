{
  "scenario_id": "timer_running_tick",
  "title": "计时器运行中状态更新",
  "description": "验证 tick 事件可以更新计时器剩余时间且任务保持 running。",
  "capability": "timer",
  "device_group": {
    "glass": "mock_glass_001",
    "phone": "mock_phone_001"
  },
  "inputs": {
    "duration_seconds": 90,
    "label": "短计时器",
    "timeline": {
      "timeline_id": "timer_running_tick",
      "events": [
        {
          "at": 100,
          "type": "timer.tick",
          "payload": {
            "remaining_seconds": 30
          }
        }
      ]
    }
  },
  "expected": {
    "tool_ok": true,
    "task_state": "running",
    "task_data": {
      "remaining_seconds": 30
    },
    "notification_contains": "短计时器已开始",
    "timeline_event_types": ["timer.tick"]
  }
}
