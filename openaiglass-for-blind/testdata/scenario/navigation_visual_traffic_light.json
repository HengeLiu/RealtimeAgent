{
  "scenario_id": "navigation_visual_traffic_light",
  "title": "导航执行期接入红绿灯视觉事件",
  "description": "验证 navigation_task 可接收手机红绿灯视觉事件并提交最小过街提示。",
  "capability": "navigation",
  "device_group": {
    "glass": "mock_glass_001",
    "phone": "mock_phone_001"
  },
  "inputs": {
    "origin": "当前位置",
    "destination": "桂林路地铁站",
    "strategy": "walking",
    "create_task": true,
    "timeline": {
      "timeline_id": "navigation_visual_traffic_light",
      "events": [
        {
          "at": 100,
          "type": "phone.vision.traffic_light.result",
          "payload": {
            "signal": "red",
            "summary": "前方红灯，请停下等待"
          }
        },
        {
          "at": 200,
          "type": "phone.vision.traffic_light.result",
          "payload": {
            "signal": "red",
            "summary": "重复红灯"
          }
        },
        {
          "at": 300,
          "type": "phone.vision.traffic_light.result",
          "payload": {
            "signal": "green",
            "summary": "前方绿灯，可以通过"
          }
        }
      ]
    }
  },
  "expected": {
    "tool_ok": true,
    "task_state": "prepared",
    "task_data": {
      "last_visual_signal": "green"
    },
    "notification_contains": ["前方红灯", "前方绿灯"],
    "timeline_event_types": ["phone.vision.traffic_light.result"],
    "mcp_trace_contains": "amap.route_plan"
  }
}
