{
  "scenario_id": "timer_cancelled",
  "title": "计时器取消路径",
  "description": "验证计时器任务取消后进入 cancelled 并提交通知。",
  "capability": "timer",
  "device_group": {
    "glass": "mock_glass_001",
    "phone": "mock_phone_001"
  },
  "inputs": {
    "duration_seconds": 120,
    "label": "两分钟计时器",
    "timeline": {
      "timeline_id": "timer_cancelled",
      "events": [
        {
          "at": 100,
          "type": "task.cancel",
          "payload": {}
        }
      ]
    }
  },
  "expected": {
    "tool_ok": true,
    "task_state": "cancelled",
    "task_data": {
      "cancel_reason": "user_cancelled",
      "label": "两分钟计时器"
    },
    "notification_contains": ["两分钟计时器已开始", "两分钟计时器已取消"],
    "timeline_event_types": ["task.cancel"]
  }
}
