{
  "scenario_id": "traffic_light_red",
  "title": "红绿灯识别红灯告警",
  "description": "验证红灯输入会触发高优先级停止提示，并结束红绿灯识别任务。",
  "capability": "traffic_light",
  "device_group": {
    "glass": "mock_glass_001",
    "phone": "mock_phone_001"
  },
  "inputs": {
    "crossing_name": "测试路口",
    "frames": ["路口画面 暂未识别", "路口画面 红灯"]
  },
  "expected": {
    "task_state": "completed",
    "task_result": {
      "signal": "red"
    },
    "notification_contains": "红灯",
    "glass_commands": ["sensor.camera.stream.start", "sensor.camera.stream.stop"],
    "phone_commands": ["sdk.phone.task.start", "sdk.phone.task.stop"]
  }
}
