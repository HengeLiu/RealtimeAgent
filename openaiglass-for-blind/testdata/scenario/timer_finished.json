{
  "scenario_id": "timer_finished",
  "title": "计时器完成通知",
  "description": "验证计时器任务可通过回放事件完成并提交通知。",
  "capability": "timer",
  "device_group": {
    "glass": "mock_glass_001",
    "phone": "mock_phone_001"
  },
  "inputs": {
    "duration_seconds": 180,
    "label": "三分钟计时器",
    "notify_text": "三分钟到了",
    "timeline": {
      "timeline_id": "timer_finished",
      "events": [
        {
          "at": 100,
          "type": "timer.tick",
          "payload": {
            "remaining_seconds": 60
          }
        },
        {
          "at": 200,
          "type": "timer.finished",
          "payload": {}
        }
      ]
    }
  },
  "expected": {
    "tool_ok": true,
    "task_state": "completed",
    "task_result": {
      "finished": true,
      "label": "三分钟计时器"
    },
    "notification_contains": ["三分钟计时器已开始", "三分钟到了"],
    "timeline_event_types": ["timer.tick", "timer.finished"]
  }
}
