{
  "device_type": "glass",
  "device_id": "glass-001",
  "pair_token": "pair-demo-token",
  "desired_phone_device_id": null,
  "control_ws_url": "ws://127.0.0.1:8765/ws/control",
  "startup": {
    "wait_for_registration": true,
    "wait_for_binding": false,
    "wait_for_voice_session": true,
    "auto_stream_trigger_audio": false,
    "startup_timeout_ms": 30000
  },
  "sensors": {
    "trigger_audio": {
      "path": "testdata/audio/帮我设置一个三分钟的计时器.wav",
      "format": "wav",
      "sample_rate_hz": 16000,
      "channels": 1,
      "chunk_ms": 40
    }
  },
  "actuators": {
    "audio_play": {
      "mode": "record_only"
    }
  },
  "outputs": {
    "event_log": "runs/playback/register-only/events.jsonl",
    "actuator_log": "runs/playback/register-only/actuators.jsonl"
  }
}
