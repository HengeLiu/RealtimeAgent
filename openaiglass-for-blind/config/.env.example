# 本文件只放敏感信息或本机私有覆盖项。
# 使用方式：
#   cp openaiglass-for-blind/config/.env.example openaiglass-for-blind/config/.env
#   然后填入真实值；.env 已加入 .gitignore，不要提交。

# 阿里云百炼 API Key。服务端调用 Agent、Omni Realtime、ASR 和 TTS 时会读取这个变量。
# 可以写在本文件，也可以在启动前通过 shell export DASHSCOPE_API_KEY=... 注入。
DASHSCOPE_API_KEY=""

# 高德 Web 服务 Key。导航真实地址搜索、地理编码和路线规划需要配置。
AMAP_API_KEY=""

# 博查 AI Search API Key。正式搜索 provider 使用该变量。
BOCHA_SEARCH_API_KEY=""
