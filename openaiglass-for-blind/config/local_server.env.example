# 盲人业务本地服务端启动配置示例。
# 使用方式：
# 1. 复制为 openaiglass-for-blind/config/local_server.env
# 2. 按当前局域网环境修改令牌
# 3. 执行 openaiglass.config.sync --app-root openaiglass-for-blind

HOST="0.0.0.0"
PORT="8765"
APP_ENV="dev"
LOG_LEVEL="DEBUG"
DEVICE_TOKEN_MAP="glass-001=pair-demo-token,phone-001=pair-phone-token"
GLASS_DEVICE_ID="glass-001"
PHONE_DEVICE_ID="phone-001"
HEARTBEAT_INTERVAL_MS="5000"
HEARTBEAT_TIMEOUT_MS="15000"
SERVER_DEVICE_ID="server-main"

# 大模型、ASR 和 TTS 配置。DASHSCOPE_API_KEY 可留空，但真实语音和 Agent 链路必须配置。
DASHSCOPE_API_KEY=""
VOICE_MODEL_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
VOICE_ASR_MODEL_NAME="qwen3-asr-flash"
VOICE_ASR_MODE="realtime"
VOICE_ASR_REALTIME_MODEL_NAME="fun-asr-realtime"
VOICE_ASR_REALTIME_TIMEOUT_MS="5000"
VOICE_ASR_REALTIME_MAX_SENTENCE_SILENCE_MS="300"
AGENT_MODEL_NAME="qwen3.5-omni-plus"
VOICE_MODEL_NAME="qwen3.5-omni-plus"
VOICE_MODEL_VOICE="Tina"
VOICE_REPLY_MODE="omni_realtime"
VOICE_INPUT_MODE="auto"
VOICE_OMNI_REALTIME_MODEL_NAME="qwen3.5-omni-plus-realtime"
VOICE_OMNI_REALTIME_URL="wss://dashscope.aliyuncs.com/api-ws/v1/realtime"
VOICE_OMNI_PHOTO_WAIT_MS="300"
# 语音对话模式：
# - realtime_semantic_vad：默认连续对话模式，由 Omni semantic_vad 负责 turn detection。
# - segment_turn：旧的单段提交模式，眼镜按一次用户语音段提交，Omni 在语音结束后响应。
VOICE_CONVERSATION_MODE="realtime_semantic_vad"
VOICE_REALTIME_TURN_DETECTION="semantic_vad"
VOICE_REALTIME_SEMANTIC_VAD_THRESHOLD="0.65"
VOICE_REALTIME_SILENCE_DURATION_MS="800"
VOICE_REALTIME_PREFIX_PADDING_MS="300"
TTS_MODEL_NAME="cosyvoice-v3-flash"
TTS_VOICE="longanhuan"
TTS_WEBSOCKET_API_URL="wss://dashscope.aliyuncs.com/api-ws/v1/inference"
TTS_SAMPLE_RATE_HZ="22050"
VOICE_MODEL_TIMEOUT_MS="45000"
VOICE_SYSTEM_PROMPT="你的名字是'乐鑫'。你是盲人眼镜上的中文语音助手，能帮助盲人用户识别图片、障碍物、引导过马路等，请用简短口语回答用户问题。"
MAX_SEGMENT_AUDIO_BYTES="524288"

# Agent 长期记忆配置。记忆文件属于本地运行数据，不要提交真实用户记忆。
AGENT_MEMORY_ENABLED="true"
AGENT_MEMORY_STORE_PATH="runs/memory/agent_memories.json"
AGENT_MEMORY_MAX_PROMPT_ITEMS="6"

# 业务侧导航与搜索配置。AMAP_API_KEY 为空时导航 adapter 会使用可回放 mock 数据。
AMAP_API_KEY=""
AMAP_DEFAULT_CITY=""
# 步行路线规划需要起点坐标；没有端侧定位时可临时填入“经度,纬度”。
AMAP_DEFAULT_ORIGIN=""
AMAP_DISABLE_MOCK_FALLBACK="false"
AMAP_HTTP_TIMEOUT_SECONDS="6"
WEB_SEARCH_TIMEOUT_SECONDS="8"

# 默认打开全双工实时语音。旧眼镜固件或只跑半双工回放时改为 half_duplex。
VOICE_SESSION_MODE="full_duplex_realtime"

# iPhone 和眼镜都能访问的 Mac 局域网 IPv4 地址。
# 执行 openaiglass.config.sync 时会自动探测并回写当前地址；
# 自动探测失败时可临时执行：
#   openaiglass.config.sync --app-root openaiglass-for-blind --public-host 192.168.1.23
SERVER_PUBLIC_HOST="192.168.1.23"
