# 盲人业务本地服务端启动配置示例。
# 使用方式：
# 1. 复制为 openaiglass-for-blind/config/local_server.env
# 2. 按当前局域网环境修改 SERVER_PUBLIC_HOST 和令牌
# 3. 执行 bash openaiglass-for-blind/scripts/sync_sdk_live_config.sh

HOST="0.0.0.0"
PORT="8765"
LOG_LEVEL="DEBUG"
DEVICE_TOKEN_MAP="glass-001=pair-demo-token,phone-001=pair-phone-token"
HEARTBEAT_INTERVAL_MS="5000"
HEARTBEAT_TIMEOUT_MS="15000"
SERVER_DEVICE_ID="server-main"

# iPhone 和眼镜都能访问的 Mac 局域网 IPv4 地址。
SERVER_PUBLIC_HOST="192.168.1.23"
