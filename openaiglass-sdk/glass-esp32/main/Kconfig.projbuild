menu "Glass Runtime Config"

config GLASS_ENABLE_WAKENET_TEST_APP
    bool "启用独立 WakeNet 测试入口"
    default n
    help
        开启后，main 组件会编译并运行 test_wakenet.c，而不是 glass_main.c。
        该模式只测试唤醒词成功率，不连接服务端，不进行语音对话。

config GLASS_WIFI_PRIMARY_SSID
    string "主 WiFi 名称"
    default ""

config GLASS_WIFI_PRIMARY_PASSWORD
    string "主 WiFi 密码"
    default ""

config GLASS_WIFI_FALLBACK_SSID
    string "兜底 WiFi 名称"
    default ""

config GLASS_WIFI_FALLBACK_PASSWORD
    string "兜底 WiFi 密码"
    default ""

config GLASS_SERVER_WS_URI
    string "服务端控制连接地址"
    default "ws://192.168.1.10:8765/ws/control"

config GLASS_DEVICE_ID
    string "眼镜设备编号"
    default "glass-001"

config GLASS_PAIR_TOKEN
    string "眼镜配对令牌"
    default "pair-demo-token"

config GLASS_FIRMWARE_VERSION
    string "固件版本"
    default "0.1.0"

config GLASS_HEARTBEAT_INTERVAL_MS
    int "设备默认心跳间隔"
    range 1000 60000
    default 5000

config GLASS_ENABLE_AEC
    bool "启用播放中插话 AEC"
    default y
    help
        开启后，语音前端使用 MIC+播放参考信号进行 AEC，并允许 Omni 连续对话窗口在播放期间继续监听。
        如果板子内存不足，或扬声器参考信号无法稳定同步，可关闭该选项回退半双工播放。

config GLASS_AEC_REFERENCE_BUFFER_MS
    int "AEC 播放参考缓冲时长"
    range 200 3000
    default 1200
    depends on GLASS_ENABLE_AEC
    help
        保存最近一段下行播放 PCM 作为 AEC 参考信号，单位毫秒。
        过短会导致回声参考不足；过长会增加内存占用。

config GLASS_BARGE_IN_GRACE_MS
    int "播放开始后的插话保护窗"
    range 0 3000
    default 900
    depends on GLASS_ENABLE_AEC
    help
        播放首段音频真正写入扬声器后的短暂保护窗，单位毫秒。
        保护窗内忽略 AEC/VAD 的播放中语音触发，避免播放起始瞬态或回声参考未收敛时把扬声器声音误判为用户插话。

config GLASS_BARGE_IN_MIN_SPEECH_FRAMES
    int "播放中插话最小连续语音帧数"
    range 1 30
    default 6
    depends on GLASS_ENABLE_AEC
    help
        保护窗结束后，VAD 需要连续命中多少帧才认为是真实用户插话。
        帧长由 ESP-SR AFE 决定，当前配置约 32ms 一帧；默认 6 帧约等于 192ms。

config GLASS_WAKE_PROMPT_TONE_ENABLE
    bool "启用唤醒成功提示音"
    default y
    help
        开启后，真实眼镜在 WakeNet 首次唤醒成功时本地播放一个短促轻提示音。
        连续对话窗口内由 VAD 触发的后续语音段不会重复播放提示音。

config GLASS_WAKE_PROMPT_TONE_DURATION_MS
    int "唤醒提示音时长"
    range 20 300
    default 70
    depends on GLASS_WAKE_PROMPT_TONE_ENABLE
    help
        提示音持续时间，单位毫秒。建议保持短促，避免干扰后续用户语音。

config GLASS_WAKE_PROMPT_TONE_FREQ_HZ
    int "唤醒提示音频率"
    range 400 3000
    default 1760
    depends on GLASS_WAKE_PROMPT_TONE_ENABLE
    help
        提示音主频，单位 Hz。

config GLASS_WAKE_PROMPT_TONE_GAIN_PERMILLE
    int "唤醒提示音音量"
    range 20 500
    default 120
    depends on GLASS_WAKE_PROMPT_TONE_ENABLE
    help
        提示音振幅，单位为千分比。默认 120 表示轻提示，避免过响。

endmenu
