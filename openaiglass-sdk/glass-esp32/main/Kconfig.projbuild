menu "Glass Runtime Config"

config GLASS_ENABLE_WAKENET_TEST_APP
    bool "启用独立 WakeNet 测试入口"
    default n
    help
        开启后，main 组件会编译并运行 test_wakenet.c，而不是 glass_main.c。
        该模式只测试唤醒词成功率，不连接服务端，不进行语音对话。

config GLASS_WIFI_PRIMARY_SSID
    string "主 WiFi 名称"
    default ""

config GLASS_WIFI_PRIMARY_PASSWORD
    string "主 WiFi 密码"
    default ""

config GLASS_WIFI_FALLBACK_SSID
    string "兜底 WiFi 名称"
    default ""

config GLASS_WIFI_FALLBACK_PASSWORD
    string "兜底 WiFi 密码"
    default ""

config GLASS_SERVER_WS_URI
    string "服务端控制连接地址"
    default "ws://192.168.1.10:8765/ws/control"

config GLASS_DEVICE_ID
    string "眼镜设备编号"
    default "glass-001"

config GLASS_PAIR_TOKEN
    string "眼镜配对令牌"
    default "pair-demo-token"

config GLASS_FIRMWARE_VERSION
    string "固件版本"
    default "0.1.0"

config GLASS_HEARTBEAT_INTERVAL_MS
    int "设备默认心跳间隔"
    range 1000 60000
    default 5000

endmenu
