{
  "name": "openai_glasses_esp32_runtime",
  "version": "sdk-v14",
  "package_type": "esp-idf-source-project",
  "idf_target": "esp32s3",
  "minimum_esp_idf": "5.4",
  "project_files": [
    "CMakeLists.txt",
    "sdkconfig.defaults",
    "partitions.csv",
    "README.md"
  ],
  "component_files": [
    "main/CMakeLists.txt",
    "main/idf_component.yml",
    "main/Kconfig.projbuild",
    "main/glass_main.c",
    "main/test_wakenet.c"
  ],
  "managed_dependencies": {
    "espressif/esp32-camera": "*",
    "espressif/esp_websocket_client": "*",
    "espressif/esp-sr": "2.1.2"
  },
  "public_capabilities": [
    "wifi_connect",
    "control_websocket",
    "device.register",
    "heartbeat",
    "audio_upload",
    "camera_capture",
    "camera_stream_to_phone",
    "notification_playback",
    "aec_barge_in",
    "wake_prompt_tone"
  ],
  "distribution_notes": [
    "sdk-v14 提供 ESP-IDF 源码工程清单和 package-check 校验，业务工程应通过配置和能力协议使用眼镜运行时。",
    "当前不是独立发布到 ESP-IDF component registry 的组件；组件仓库发布需要后续拆分 main 组件边界。"
  ]
}
