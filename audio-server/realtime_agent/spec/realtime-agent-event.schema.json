{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:realtime-agent:event.schema.json",
  "title": "realtime-agent control event envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "event_id", "event_name", "timestamp_ms", "user_id", "producer_id", "payload"],
  "properties": {
    "version": {"type": "string", "const": "realtime-agent.v1"},
    "event_id": {"type": "string", "minLength": 1},
    "event_name": {
      "type": "string",
      "enum": [
        "control.device.register.requested",
        "control.device.registered",
        "control.device.register.failed",
        "control.device.heartbeat.received",
        "control.device.state.changed",
        "control.user.wake.detected",
        "control.user.dialog.close.requested",
        "control.user.interrupt.detected",
        "control.audio_session.open.requested",
        "control.audio_session.opened",
        "control.audio_session.close.requested",
        "control.audio_session.closed",
        "control.audio_session.turn.ignored",
        "voice.turn.ignored",
        "command.requested",
        "command.accepted",
        "command.progress",
        "command.completed",
        "command.failed",
        "stream.control.open.requested",
        "stream.control.close.requested",
        "stream.input.opened",
        "stream.input.closed",
        "stream.input.failed",
        "stream.output.open.requested",
        "stream.output.close.requested",
        "stream.output.finish.requested",
        "stream.output.started",
        "stream.output.finished",
        "stream.output.closed",
        "stream.output.failed",
        "stream.output.cancel.requested",
        "stream.output.cancelled",
        "agent.response.started",
        "agent.response.completed",
        "tool.call.started",
        "tool.call.completed",
        "task.event.start",
        "task.event.process",
        "task.event.status",
        "task.event.finish",
        "task.event.cancel",
        "task.event.error",
        "task.state.changed",
        "system.error.raised"
      ]
    },
    "timestamp_ms": {"type": "integer", "minimum": 0},
    "user_id": {"type": "string", "minLength": 1},
    "producer_id": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "stream_id": {"type": "string", "minLength": 1},
    "stream_type": {"$ref": "#/$defs/streamType"},
    "payload": {"$ref": "#/$defs/payload"}
  },
  "$defs": {
    "payload": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "integer", "boolean", "array", "object", "null"]
      }
    },
    "streamType": {
      "type": "string",
      "enum": [
        "sensor.mic",
        "sensor.rgb",
        "sensor.imu",
        "sensor.tof",
        "sensor.depth",
        "actuator.speaker",
        "actuator.haptic",
        "actuator.vibrator"
      ]
    }
  }
}
